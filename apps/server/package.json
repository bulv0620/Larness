{
  "name": "@larness/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.js",
    "status": "tsx src/cli/status.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "db:generate": "drizzle-kit generate --name auth",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "tui": "tsx src/tui/main.ts --managed --dev",
    "tui:dev": "tsx src/tui/main.ts --managed --dev"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.78",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.6",
    "@inquirer/prompts": "^8.7.5",
    "@larness/agent": "workspace:*",
    "@larness/resources": "workspace:*",
    "@larness/shared": "workspace:*",
    "@simplewebauthn/server": "^14.0.3",
    "ai": "^6.0.320",
    "better-sqlite3": "12.6.2",
    "cron-parser": "5.10.4",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "env-paths": "^4.0.0",
    "fast-string-width": "3.0.2",
    "fast-wrap-ansi": "0.2.2",
    "fastify": "^5.12.7",
    "node-pty": "^1.1.0",
    "picocolors": "^1.1.1",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "semver": "^7.8.5",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsdown": "^0.21.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
