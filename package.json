{
  "name": "larness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @larness/server run tui:dev",
    "dev:web": "pnpm --filter @larness/web dev",
    "dev:server": "pnpm --filter @larness/server dev",
    "build": "pnpm typecheck && pnpm --filter @larness/server build && pnpm --filter @larness/web build",
    "status": "pnpm --filter @larness/server run status",
    "doctor": "pnpm --filter @larness/server run doctor",
    "preview": "pnpm --filter @larness/web preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "biome ci . && pnpm typecheck && pnpm test",
    "test:e2e": "playwright test",
    "format": "biome format --write .",
    "demo:shots": "node scripts/capture-demo.mjs",
    "tui": "pnpm --filter @larness/server run tui:dev",
    "test:e2e:auth": "playwright test -c playwright.auth.config.ts",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "test:smoke:init": "pnpm --filter @larness/server exec tsx scripts/smoke-init.ts",
    "test:tui:pty": "python3 scripts/test-tui-pty.py",
    "test:smoke:unified": "pnpm --filter @larness/server exec tsx scripts/smoke-unified.ts",
    "test:poc:m2": "pnpm --filter @larness/server exec tsx scripts/run-m2-poc.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "bin": {
    "larness": "./app.js"
  }
}
