{
  "name": "larness",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @larness/server run tui:dev",
    "dev:web": "pnpm --filter @larness/web dev",
    "dev:server": "pnpm --filter @larness/server dev",
    "build": "pnpm typecheck && pnpm --filter @larness/server build && pnpm --filter @larness/web build",
    "status": "pnpm --filter @larness/server run status",
    "doctor": "pnpm --filter @larness/server run doctor",
    "preview": "pnpm --filter @larness/web preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "check": "biome ci . && pnpm typecheck && pnpm test",
    "test:e2e": "playwright test",
    "format": "biome format --write .",
    "demo:shots": "node scripts/capture-demo.mjs",
    "tui": "pnpm --filter @larness/server run tui:dev",
    "test:e2e:auth": "playwright test -c playwright.auth.config.ts",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "test:smoke:init": "pnpm --filter @larness/server exec tsx scripts/smoke-init.ts",
    "test:tui:pty": "python3 scripts/test-tui-pty.py",
    "test:smoke:unified": "pnpm --filter @larness/server exec tsx scripts/smoke-unified.ts",
    "test:poc:m2": "pnpm --filter @larness/server exec tsx scripts/run-m2-poc.ts",
    "test:poc:m3": "LARNESS_POC_BROWSER=1 pnpm --filter @larness/server exec vitest run test/resources/m3-poc.test.ts test/resources/m3-preview-poc.test.ts test/resources/m3-vite-poc.test.ts test/resources/m3-failure-poc.test.ts test/resources/m3-policy-poc.test.ts",
    "test:poc:m4": "LARNESS_POC_PM2=1 pnpm --filter @larness/server exec vitest run test/resources/m4-poc.test.ts",
    "test:poc:m5-1b": "pnpm --filter @larness/server exec tsx scripts/poc-m5-1b.ts",
    "test:pm2:m4": "LARNESS_POC_PM2=1 pnpm --filter @larness/server exec vitest run test/resources/service-ops-pm2.test.ts test/resources/m4-4-integration.test.ts",
    "verify:pack": "node scripts/verify-npm-pack.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.78",
    "@ai-sdk/openai-compatible": "^2.0.91",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.6",
    "@inquirer/prompts": "^8.7.5",
    "@simplewebauthn/server": "^14.0.3",
    "ai": "^6.0.320",
    "better-sqlite3": "12.6.2",
    "cron-parser": "5.10.4",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "env-paths": "^4.0.0",
    "fast-string-width": "3.0.2",
    "fast-wrap-ansi": "0.2.2",
    "fastify": "^5.12.7",
    "node-pty": "^1.1.0",
    "picocolors": "^1.1.1",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "semver": "^7.8.5",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "larness": "app.js"
  },
  "version": "0.1.0",
  "description": "Larness — local-first agent workspace for projects, terminals, services and deployments",
  "license": "MIT",
  "keywords": [
    "agent",
    "ai",
    "workspace",
    "terminal",
    "pm2",
    "deepseek",
    "glm",
    "larness"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "app.js",
    "apps/server/dist",
    "apps/server/drizzle",
    "apps/server/package.json",
    "apps/web/dist",
    "README.md",
    "LICENSE",
    "docs/guides/install.md"
  ]
}
